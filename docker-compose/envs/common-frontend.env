NEXT_PUBLIC_API_HOST=scan.vcrchain.com
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_STATS_API_HOST=https://scan.vcrchain.com
NEXT_PUBLIC_NETWORK_NAME=VCR Chain
NEXT_PUBLIC_NETWORK_SHORT_NAME=VCR
NEXT_PUBLIC_NETWORK_ID=314169
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=ChronoCore Reserve
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=CCR
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_APP_HOST=scan.vcrchain.com
NEXT_PUBLIC_APP_PROTOCOL=https
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
NEXT_PUBLIC_VISUALIZE_API_HOST=https://scan.vcrchain.com/visualizer
NEXT_PUBLIC_IS_TESTNET=false
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss
# Required to enable blockchain interaction
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_NETWORK_RPC_URL=https://mainnet-rpc.vcrchain.com
NEXT_PUBLIC_NETWORK_CURRENCY_WEI_NAME=wei
NEXT_PUBLIC_NETWORK_CURRENCY_GWEI_NAME=gwei
NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE=validation
NEXT_PUBLIC_HIDE_NATIVE_COIN_PRICE=true
NEXT_PUBLIC_INTERNAL_TXS_ENABLED=false
NEXT_PUBLIC_HOMEPAGE_STATS=['total_blocks','average_block_time','total_txs','wallet_addresses']

NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_STATS_API_BASE_PATH=/stats

NEXT_PUBLIC_API_DOCS_TABS=[]

NEXT_PUBLIC_GAS_TRACKER_ENABLED=true

# VCR Chain brand assets, hosted by the VCR frontend.
NEXT_PUBLIC_NETWORK_LOGO=https://scan.vcrchain.com/vcr-assets/vcr-logo-7x1.png
NEXT_PUBLIC_NETWORK_LOGO_DARK=https://scan.vcrchain.com/vcr-assets/vcr-logo-7x1.png
NEXT_PUBLIC_NETWORK_ICON=https://scan.vcrchain.com/vcr-assets/200.png
NEXT_PUBLIC_NETWORK_ICON_DARK=https://scan.vcrchain.com/vcr-assets/200.png
FAVICON_MASTER_URL=https://scan.vcrchain.com/vcr-assets/200.png
NEXT_PUBLIC_GAS_TRACKER_UNITS=["gwei"]